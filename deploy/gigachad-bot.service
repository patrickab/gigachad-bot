[Unit]
Description=gigachad-bot FastAPI backend
Wants=network-online.target gigachad-bot-pi-host.service
After=network-online.target gigachad-bot-pi-host.service

[Service]
Type=exec
WorkingDirectory=%h/git/gigachad-bot-prod
Environment=GIGACHAD_ENV_FILE=%h/.config/gigachad-bot/env
# Production's pi-host (gigachad-bot-pi-host.service), development's runs on the default 127.0.0.1:8300
Environment=GIGACHAD_PI_HOST_URL=http://127.0.0.1:8301
# Sandbox containers reach that pi-host's completion gateway (the AiB profiles default to development's 8300)
Environment=PI_GATEWAY_PORT=8301
ExecStart=%h/git/gigachad-bot-prod/run-backend.sh --prod
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
