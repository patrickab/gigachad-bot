[Unit]
Description=gigachad-bot FastAPI backend
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
WorkingDirectory=%h/git/gigachad-bot-prod
Environment=GIGACHAD_ENV_FILE=%h/.config/gigachad-bot/env
ExecStart=%h/git/gigachad-bot-prod/deploy/run-production-backend.sh
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
