{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "gigachad-bot",
  "version": "0.1.0",
  "identifier": "com.gigachadbot.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out",
    "devUrl": "http://127.0.0.1:2999"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GigaChat Bot",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "resources": {
      "binaries/gigachad-sidecar": "sidecar"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
